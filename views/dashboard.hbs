{{!-- views/dashboard.hbs --}}
<h2 class="dashboard-title">Dashboard</h2>

<div class="dashboard-container">

  {{!-- 📚 Books Section --}}
  <section class="section books-section">
    <h3>Books</h3>
    <div class="cards-scroll">
      {{#each books}}
      <div class="card">
        <p><strong>Book title:</strong> {{this.title}}</p>
        <div class="actions">
          <a href="/books/{{this._id}}" class="details-btn small">Book details</a>
          <a href="/books/{{this._id}}/edit" class="btn secondary small">Edit</a>

          <form action="/books/{{this._id}}/delete" method="POST" style="display:inline;"
            data-confirm="true" data-confirm-message="Remove the book &quot;{{this.title}}&quot;?">
            <button type="submit" class="btn small danger">Remove</button>
          </form>
        </div>
      </div>
      {{else}}
      <p class="empty">No books yet.</p>
      {{/each}}
    </div>


    <a href="/books/add" class="btn primary">Add book</a>
  </section>

  {{!-- 📝 Notes Section --}}
  <section class="section notes-section">
    <h3>Notes</h3>

    <div class="cards-scroll">
      {{#each notes}}
      <div class="card">
        <p><strong>Note title:</strong> {{this.title}}</p>
        <div class="actions">
          <a href="/notes/{{this._id}}" class="details-btn small">Read note</a>
          <a href="/notes/{{this._id}}/edit" class="btn secondary small">Edit</a>

          <form action="/notes/{{this._id}}/delete" method="POST" style="display:inline;"
            data-confirm="true" data-confirm-message="Remove the note &quot;{{this.title}}&quot;?">
            <button type="submit" class="btn small danger">Remove</button>
          </form>
        </div>
      </div>
      {{else}}
      <p class="empty">No notes yet.</p>
      {{/each}}
    </div>

    <a href="/notes/add" class="btn primary">Add to notes</a>

  </section>

  {{!-- 💡 Flashcards Section --}}
  <section class="section flashcards-section">
    <h3>Flashcards</h3>
    <p class="flashcard-count">You have {{flashcardsCount}} flashcards</p>
    <div class="actions column">
    <a href="/flashcards/quiz" class="details-btn">Take a quiz</a>
    <a href="/flashcards/list" class="details-btn">View flashcards list</a>
    <a href="/flashcards/new" class="add-btn">Add a new flashcard</a>

    </div>
  </section>

</div>

<div id="confirm-modal" class="confirm-modal hidden" aria-hidden="true" role="dialog" aria-modal="true">
  <div class="confirm-modal__content">
    <p class="confirm-modal__message" data-confirm-modal-message>Are you sure?</p>
    <div class="modal-actions">
      <button type="button" class="btn secondary" data-confirm-cancel>Cancel</button>
      <button type="button" class="btn danger" data-confirm-accept>Yes, remove</button>
    </div>
  </div>
</div>
