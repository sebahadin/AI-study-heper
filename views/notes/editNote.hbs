<h2>Edit note</h2>
<form action="/notes/{{note._id}}/edit" method="POST" class="form-container">
  <input type="text" name="title" value="{{note.title}}" required />
  <textarea name="content" required>{{note.content}}</textarea>

  <label for="book">Optional: related to book</label>
  <select name="book" id="book">
    <option value="">None</option>
    {{#each books}}
      <option value="{{this._id}}" {{#ifEquals this._id ../note.book}}selected{{/ifEquals}}>
        {{this.title}}
      </option>
    {{/each}}
  </select>

  <button type="submit" class="btn primary">Confirm edit</button>
</form>
<a href="/dashboard" class="back-link">← Go back</a>
