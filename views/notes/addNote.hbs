<h2>Add note</h2>
<form action="/notes/add" method="POST" class="form-container">
  <input type="text" name="title" placeholder="Note title (e.g., Chapter 3 Summary)" required />
  <textarea name="content" placeholder="Key insights, quotes, or thoughts you want to remember" required></textarea>

  <label for="book">Optional: related to book</label>
  <select name="book" id="book">
    <option value="">None</option>
    {{#each books}}
      <option value="{{this._id}}">{{this.title}}</option>
    {{/each}}
  </select>

  <button type="submit" class="btn primary">Proceed</button>
</form>
<a href="/dashboard" class="back-link">← Go back</a>
<script> src="/js/validation.js">
</script>
