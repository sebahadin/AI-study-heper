<section class="section detail-view">
  <header class="detail-header">
    <p class="eyebrow">Note</p>
    <h2>{{note.title}}</h2>
    {{#if note.book}}
      <p class="detail-subtitle">Linked to <strong>{{note.book.title}}</strong></p>
    {{/if}}
  </header>

  <article class="detail-body">
    <h3>Content</h3>
    <p>{{note.content}}</p>
  </article>

  <div class="actions spaced">
    <a href="/dashboard" class="btn secondary">← Back</a>
    <a href="/notes/{{note._id}}/edit" class="details-btn">Edit note</a>
  </div>
</section>
