<section class="section detail-view">
  <header class="detail-header">
    <p class="eyebrow">Book</p>
    <h2>{{book.title}}</h2>
    <p class="detail-subtitle">by {{book.author}}</p>
  </header>

  <dl class="detail-grid">
    <div>
      <dt>Category</dt>
      <dd>{{book.category}}</dd>
    </div>

    {{#if book.url}}
    <div>
      <dt>Link</dt>
      <dd><a href="{{book.url}}" target="_blank" rel="noopener">Visit book site</a></dd>
    </div>
    {{/if}}
  </dl>

  <article class="detail-body">
    <h3>Summary</h3>
    <p>{{book.description}}</p>
  </article>

  <div class="actions spaced">
    <a href="/dashboard" class="btn secondary">← Back</a>
    <a href="/books/{{book._id}}/edit" class="details-btn">Edit book</a>
  </div>
</section>
