<h2>Add new book</h2>
<form action="/books/add" method="POST" class="form-container">
  <input type="text" name="title" placeholder="Book title (e.g., Atomic Habits)" required />
  <input type="text" name="author" placeholder="Author name (e.g., James Clear)" required />
  <textarea name="description" placeholder="Short summary or key ideas from this book"></textarea>
  <input type="text" name="url" placeholder="Optional link to buy or read the book" />
  <input type="text" name="category" placeholder="Category or genre (e.g., Productivity)" required />
  <button type="submit" class="btn primary">Proceed</button>
</form>
<a href="/dashboard" class="back-link">← Go back</a>

<script> src="/js/validation.js"></script>
