<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>StudyHelper</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>

<body>
  <header class="app-header">
    {{#if user}}
    <h1><a href="/dashboard" class="logo">StudyHelper</a></h1>
    <a href="/logout" class="btn logout-btn">Logout</a>
    {{else}}
    <h1><a href="/login" class="logo">StudyHelper</a></h1>
    {{/if}}
  </header>


  <main>
    {{{body}}}
  </main>

  <div id="confirm-modal" class="confirm-modal hidden" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="confirm-modal__content">
      <p class="confirm-modal__message" data-confirm-modal-message>Are you sure?</p>
      <div class="modal-actions">
        <button type="button" class="btn secondary" data-confirm-cancel>Cancel</button>
        <button type="button" class="btn danger" data-confirm-accept>Yes, remove</button>
      </div>
    </div>
  </div>

  <div id="alert-modal" class="alert-modal confirm-modal hidden" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="confirm-modal__content">
      <p class="eyebrow" data-alert-title>Notice</p>
      <p class="confirm-modal__message" data-alert-message>Something happened.</p>
      <div class="modal-actions">
        <button type="button" class="btn primary" data-alert-close>Okay</button>
      </div>
    </div>
  </div>

  <script type="module" src="/js/confirm.js"></script>
</body>

</html>
