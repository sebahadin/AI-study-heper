{{!< layout}} {{!-- if you’re using a layout; otherwise remove --}}
<section class="section">
  <h3>Add Flashcard</h3>

  {{#if error}}<p class="error-message">{{error}}</p>{{/if}}

  <form method="POST" action="/flashcards/new" class="form" id="flashcardForm" data-validate="flashcard">
    <label>Question</label>
    <input type="text" name="question" required>

    <div class="grid-2">
      <div>
        <label>Option 1</label>
        <input type="text" name="option1" required>
      </div>
      <div>
        <label>Option 2</label>
        <input type="text" name="option2" required>
      </div>
      <div>
        <label>Option 3 (optional)</label>
        <input type="text" name="option3">
      </div>
      <div>
        <label>Option 4 (optional)</label>
        <input type="text" name="option4">
      </div>
    </div>

    <label>Correct Answer</label>
    <select name="correctIndex" required>
      <option value="0">Option 1</option>
      <option value="1">Option 2</option>
      <option value="2">Option 3</option>
      <option value="3">Option 4</option>
    </select>

    <label>Tags (choose one or more books)</label>
    <div class="tag-grid" data-tag-group>
      {{#if books.length}}
        {{#each books}}
          <label class="tag-checkbox">
            <input type="checkbox" name="tags" value="{{this._id}}">
            <span>{{this.title}}</span>
          </label>
        {{/each}}
      {{else}}
        <p class="muted">Add some books first so you can tag this flashcard.</p>
      {{/if}}
    </div>

    <button type="submit" class="add-btn">Save Flashcard</button>
  </form>
</section>
