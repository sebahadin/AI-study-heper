# Reference only: the service reads the repository-root .env, not this file.
# Generate a dedicated secret; share it with Express on the server only.
# python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Never use a provider key, Passport session secret, or a VITE_ variable.
AI_SERVICE_TOKEN=

# Optional override; default is 10 MiB. Python owns this upload policy.
AI_MAX_PDF_BYTES=10485760
