# Reference only: the service reads the repository-root .env, not this file.
# Generate a dedicated secret; share it with Express on the server only.
# python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Never use a provider key, Passport session secret, or a VITE_ variable.
AI_SERVICE_TOKEN=

# Optional override; default is 10 MiB. Python owns this upload policy.
AI_MAX_PDF_BYTES=10485760

# Local embeddings and Chroma; optional defaults (copy to repository-root .env).
# Keep the model and exact revision together when choosing a different model.
AI_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
AI_EMBEDDING_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
AI_EMBEDDING_DEVICE=cpu
AI_EMBEDDING_BATCH_SIZE=16
# Set true after downloading the pinned model to prohibit Hub network access.
AI_EMBEDDING_LOCAL_FILES_ONLY=false
# Default caches are anchored at ai-service/.cache/ and ignored by Git.
# Optional absolute paths for persistent deployment volumes:
# AI_EMBEDDING_CACHE_PATH=/private/model-cache
# AI_CHROMA_PATH=/private/chroma
